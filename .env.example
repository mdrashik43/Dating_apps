SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# postgres (default) or sqlite
DB_ENGINE=postgres
DB_NAME=vibematch
DB_USER=vibematch_user
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Private verification documents are stored OUTSIDE MEDIA_ROOT
PRIVATE_MEDIA_ROOT=private_media
# Email: console prints emails in the terminal. For real email use smtp settings.
EMAIL_BACKEND=accounts.mail.PlainConsoleEmailBackend
DEFAULT_FROM_EMAIL=Vibe Match <no-reply@vibematch.local>
FRONTEND_URL=http://localhost:5173
GAME_DAILY_SESSION_LIMIT=20
